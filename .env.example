# Names only. Never commit a value. Set one with the CLI:
#   vercel env add <NAME> <environment>

# Clerk owns operator sign-in. Development keys locally and on previews, production
# keys only in the production environment. Pull them with: clerk env pull --file .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keeps sign-in on the existing routes instead of Clerk's defaults.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Optional. The platform-funded model, used by a tenant that has brought no key of
# its own. Without it, sessions still connect and a fallback reply is returned.
XAI_API_KEY=

# Required before a tenant can store a provider key of its own. Wraps every stored
# key with AES-256-GCM. Any passphrase length works. Generate one with:
#   openssl rand -base64 32
# Rotating it makes every stored provider key undecryptable, and each tenant has to
# add its keys again. There is no re-wrap path.
CREDENTIAL_SECRET=

# Required. Neon Postgres, the datastore. Provisioned as the Vercel Marketplace
# resource voice-studio-db, so the values arrive with:
#   vercel env pull .env.local
# DATABASE_URL is the pooled endpoint and is what the app runs on. Every store
# module reads it through src/lib/db/index.ts.
DATABASE_URL=
# The direct endpoint, used by `pnpm db:push` only. Schema changes do not belong
# on the pooled endpoint, which runs through pgbouncer in transaction mode.
DATABASE_URL_UNPOOLED=
