# Names only. Never commit a value. Set one with the CLI:
#   vercel env add <NAME> <environment>

# Clerk, once the auth migration lands. Development keys locally and on previews,
# production keys only in the production environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keeps sign-in on the existing routes instead of Clerk's defaults.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Optional. The platform-funded model, used by a tenant that has brought no key of
# its own. Without it, sessions still connect and a fallback reply is returned.
XAI_API_KEY=

# Required before a tenant can store a provider key of its own. Wraps every stored
# key with AES-256-GCM. Any passphrase length works. Generate one with:
#   openssl rand -base64 32
# Rotating it makes every stored provider key undecryptable, and each tenant has to
# add its keys again. There is no re-wrap path.
CREDENTIAL_SECRET=

# Optional. Overrides data/voice-studio.db.
# DATABASE_PATH=

# Retires with the Clerk migration. Auto-generated into data/.auth-secret if unset.
# AUTH_SECRET=
